Shinies
    *glow
        name:Wisp|Wisps
        desc:What's this?
        //icon: golden ball

        on click:
			(lose 1 debt)
			if (chance(13%))
				yield 1 hanabi
			else
				yield random(5,101) bi
			end
		end

        duration:9
        movement:anywhere wiggle bounce
        frequency:555
        frequency variation:333
		req:(25 fawksButton clicks and badluck<98)

    *fog
        name:Mysterious Haze|Mysterious Hazes
        desc:What's this?
        //icon:golden ball reskinned
        on click:(multiply misfortune by 1.1) and (win 1 debt)
        movement:onBottom moveTop wiggle fade
        duration:14
        frequency:444
        frequency variation:4444-(4*badluck)
		//variation goes down with more badluck. Say 4% per increment?
        tags:misfortune
		req:1 fawksButton clicks



